# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# TypeScript, JavaScript, JSON
[*.{ts,js,json}]
indent_size = 2
max_line_length = 100

# Package files
[package.json]
indent_size = 2

# Config files
[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = 80

# SQL files
[*.sql]
indent_size = 2
max_line_length = 120

# Environment files
[.env*]
insert_final_newline = true